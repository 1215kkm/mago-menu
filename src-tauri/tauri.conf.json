{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MAGO",
  "version": "0.1.2",
  "identifier": "com.mago.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "settings",
        "title": "MAGO",
        "url": "index.html",
        "width": 760,
        "height": 820,
        "minWidth": 520,
        "minHeight": 560,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://raw.githubusercontent.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Korean"
        ],
        "installMode": "currentUser",
        "displayLanguageSelector": false,
          "installerHooks": "./windows/hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/1215kkm/mago-menu/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE3RjY1ODdDMkRBQzQzNUQKUldSZFE2d3RmRmoycDN1c1h5bG9PcTEvR0F0QS9GSis4NVRRMElVZVhGeUtzT0tmSDlreEgvUTEK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}