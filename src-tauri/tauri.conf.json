{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "시프트 메뉴",
  "version": "0.1.0",
  "identifier": "com.shiftmenu.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "settings",
        "title": "시프트 메뉴",
        "url": "index.html",
        "width": 760,
        "height": 820,
        "minWidth": 520,
        "minHeight": 560,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": { "languages": ["Korean"], "installMode": "currentUser", "displayLanguageSelector": false }
    }
  }
}
